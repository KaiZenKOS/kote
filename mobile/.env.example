# Copier en .env avant de lancer l'application.
# Les valeurs locales sont donnees par : npx supabase status
#
# Ces deux variables sont publiques par construction : elles sont embarquees
# dans le binaire. C'est sans danger, la cle anonyme n'a aucun privilege sur la
# table `marchand` (voir la migration 000900 du backend). La cle de service, en
# revanche, ne doit JAMAIS figurer ici.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
