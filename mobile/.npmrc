# expo-router@57 depend de vaul, qui depend de composants Radix exigeant
# react-dom ^19.2.8, alors que le SDK Expo epingle react 19.2.3. Le conflit est
# interne au graphe d'Expo et sans effet sur React Native, ou react-dom n'est
# jamais charge. Sans ce reglage, toute installation ulterieure echoue.
legacy-peer-deps=true
