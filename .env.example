# ---------------------------------------------------------------------------
# Variables des fonctions edge. Copier en .env.local, ne jamais versionner.
# En production, les definir avec : npx supabase secrets set CLE=valeur
# ---------------------------------------------------------------------------

# Nom commercial insere dans le message WhatsApp pre-rempli.
# Arbitre le 2026-08-03 : Kote, « juste a cote ». Aucune reference a la
# formalisation, a l'administration ni a la fiscalite (cahier des charges 3.1).
NOM_APPLICATION=Koté

# Assistance a la redaction. Sans cle, la fonction repond 503 et le marchand
# peut toujours publier sa fiche : l'IA est un confort, pas un prerequis.
ANTHROPIC_API_KEY=
# Modele choisi pour son cout par requete (cahier des charges, section 7.1).
MODELE_IA=claude-haiku-4-5-20251001

# Secret partage protegeant la tache d'entretien quotidienne.
CLE_ENTRETIEN=
